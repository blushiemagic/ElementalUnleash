Items: {
	BlushieCharm: {
		DisplayName: Charm of Blushie
		Tooltip:
			'''
			Your hearts shall spell the doom of your enemies
			Can be used by any class
			Made in celebration of blushiemagic's love
			'''
	}

	BlushieCheckpoint: {
		Tooltip:
			'''
			Use this item to die
			Starts the fight at phase 3
			Can be reused infinitely
			Each player starts at {0}% max health
			WARNING: Use this in the middle of a large open area (eg. the sky)
			It is highly recommended that you use the Purity Shield [i:5640] mount
			Right-click to focus the camera on the entire boss arena
			Right-click mid-fight to toggle the camera focus
			Your hitbox becomes a single pixel
			'''
		DisplayName: Blushie Checkpoint
	}

	BlushieCrystal: {
		Tooltip:
			'''
			Use this item to die
